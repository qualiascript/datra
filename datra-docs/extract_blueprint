#!/usr/bin/env python3
"""Extract LaTeX blocks or strip them from Lean source files."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
from lean_sources import ROOT, imports, local_module, project_sources

BLUEPRINT_BLOCK = re.compile(r"/-%%\s*\n?(.*?)\n?%%-/", re.DOTALL)


def extract(path: Path) -> list[str]:
    source = path.read_text(encoding="utf-8")
    return [block.strip() for block in BLUEPRINT_BLOCK.findall(source)]


def strip_blueprint(path: Path) -> str:
    source = path.read_text(encoding="utf-8")
    stripped = BLUEPRINT_BLOCK.sub("", source)
    return re.sub(r"\n{3,}", "\n\n", stripped).lstrip()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="extract embedded LaTeX blueprint blocks from Lean files"
    )
    parser.add_argument(
        "-L",
        "--lean",
        action="store_true",
        help="print Lean source with the embedded blueprint blocks removed",
    )
    parser.add_argument("files", nargs="+", type=Path, metavar="FILE.lean")
    args = parser.parse_args()
    try:
        paths = project_sources(args.files)
    except (OSError, ValueError) as error:
        parser.error(str(error))

    if args.lean:
        sources: list[str] = []
        external_imports: list[str] = []
        local_paths = set(paths)
        for path in paths:
            try:
                source = strip_blueprint(path)
                for module in imports(source):
                    dependency = local_module(module)
                    if dependency not in local_paths and module not in external_imports:
                        external_imports.append(module)
                source = re.sub(r"(?m)^import\s+[^\n]*\n?", "", source).strip()
                if source:
                    label = path.relative_to(ROOT) if path.is_relative_to(ROOT) else path.name
                    sources.append(f"-- Source: {label}\n\n{source}")
            except OSError as error:
                parser.error(str(error))
        sources.insert(0, "\n".join(f"import {module}" for module in external_imports))
        sys.stdout.write("\n\n".join(sources))
        if sources:
            sys.stdout.write("\n")
        return 0

    blocks: list[str] = []
    for path in paths:
        try:
            blocks.extend(extract(path))
        except OSError as error:
            parser.error(str(error))

    sys.stdout.write("\n\n".join(blocks))
    if blocks:
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
