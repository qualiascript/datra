        src/DatraCore/Atlases/Core/DomanialInsertion
        src/DatraCore/Atlases/Core/Folio
    default-language: GHC2021

executable datra-haskell
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Interpreting
        RuntimeModules
        ModuleNames
        ModuleLoading
        FunctionInference
        StdLib
        SyntaxDefinitions
        Parsing
        Rendering
    build-depends:
        base >= 4.14 && < 5,
        datra-haskell,
        filepath >= 1.4 && < 1.6,
        directory >= 1.3 && < 1.4,
        megaparsec >= 9.8 && < 10,
        template-haskell < 2.25,
        optparse-applicative >= 0.18 && < 0.20,
        parser-combinators >= 1.3 && < 2,
        prettyprinter >= 1.7 && < 1.8,
        text >= 2.0 && < 2.2,
        transformers >= 0.5 && < 0.7
    hs-source-dirs:   app
    default-language: GHC2021

test-suite datra-core-test
    import:           warnings, test-dependencies
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          DatraCoreTests.hs
    build-depends:
        base >= 4.14 && < 5,
        datra-haskell

test-suite datra-types-test
    import:           warnings, test-dependencies
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          DatraTypesTests.hs
    build-depends:
        base >= 4.14 && < 5,
        containers >= 0.6 && < 0.9,
        datra-haskell

test-suite datra-parsing-test
    import:           warnings, test-dependencies
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:
        test
        app
    main-is:          DatraParsingTests.hs
    other-modules:
        Parsing
        StdLib
        SyntaxDefinitions
        ModuleNames
    ghc-options:      -main-is DatraParsingTests.main
    build-depends:
        template-haskell,
        filepath,
        base >= 4.14 && < 5,
        datra-haskell,
        megaparsec >= 9.8 && < 10,
        parser-combinators >= 1.3 && < 2,
        text >= 2.0 && < 2.2,
        transformers >= 0.5 && < 0.7

test-suite datra-interpreting-test
    import:           warnings, test-dependencies
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:
        test
        app
    main-is:          DatraInterpretingTests.hs
    other-modules:
        Datra.Interpreter.DatraTypeLawTests
        Datra.Interpreter.FunctionTests
        Datra.Interpreter.IntegrationTests
        Datra.Interpreter.ModuleTests
        Datra.Interpreter.OverloadAssertionTests
        Datra.Interpreter.ScopeTests
        Datra.Interpreter.StandardLibraryTests
        Datra.TestSupport
        Interpreting
        RuntimeModules
        ModuleNames
        ModuleLoading
        FunctionInference
        StdLib
        SyntaxDefinitions
        Parsing
        Rendering
    ghc-options:      -main-is DatraInterpretingTests.main
    build-depends:
        filepath,
        directory,
        template-haskell,
        base >= 4.14 && < 5,
        datra-haskell,
        megaparsec >= 9.8 && < 10,
        parser-combinators >= 1.3 && < 2,
        prettyprinter >= 1.7 && < 1.8,
        text >= 2.0 && < 2.2,
        transformers >= 0.5 && < 0.7

test-suite datra-cli-test
    import:           warnings, test-dependencies
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          DatraCliTests.hs
    build-tool-depends:
        datra-haskell:datra-haskell
    build-depends:
        base >= 4.14 && < 5,
        datra-haskell,
        directory >= 1.3 && < 1.4,
        process >= 1.6 && < 1.7,
        tasty >= 1.5 && < 1.6,
        tasty-hunit >= 0.10 && < 0.11
