        src/DatraCore/Atlases/Derived/AtlasConfederations/AtlasHorizontalSum
        src/DatraCore/Atlases/Derived/Cartography
        src/DatraCore/Atlases/Derived/Cartography/AtlasMap
        src/DatraCore/Atlases/Derived/Cartography/TotalAtlasMap
        src/DatraCore/Atlases/Derived/Cartography/AtlasTransversalMap
