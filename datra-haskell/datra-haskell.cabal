cabal-version:      3.0
name:               datra-haskell
version:            0.1.0.0
synopsis:           A new Haskell project
description:
    A parser, interpreter, type system, and command-line implementation of the
    Datra language.
license:            Apache-2.0
license-file:       LICENSE
author:             qualiascript
maintainer:         qualiascript
copyright:          2026 qualiascript
homepage:           https://github.com/qualiascript/datra
bug-reports:        https://github.com/qualiascript/datra/issues
category:           Development
build-type:         Simple
tested-with:        GHC == 9.14.1
extra-doc-files:
    CHANGELOG.md
    README.md
    NOTICE
extra-source-files:
    std_lib.datra
    test/fixtures/cli/*.ast
    test/fixtures/cli/*.datra
    test/fixtures/cli/*.out
    test/fixtures/integration/*.datra
    test/fixtures/modules/*.datra
    src/DatraCore/LiquidPlugin.h

common warnings
    ghc-options: -Wall

common test-dependencies
    build-depends:
        hedgehog >= 1.4 && < 1.8,
        tasty >= 1.5 && < 1.6,
        tasty-hedgehog >= 1.4 && < 1.5,
        tasty-hunit >= 0.10 && < 0.11

flag liquid
    description: Enable LiquidHaskell verification during ordinary builds
    default:     True
    manual:      True

