yield Ordinals := begin

  OrdValue := (Ordinal | Nat)

  sum := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> OrdValue) !^"datra.ordinal.sum"
  prod := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> OrdValue) !^"datra.ordinal.prod"
  minus := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> OrdValue) !^"datra.ordinal.minus"
  exp := "$_Expr $_Expr" as? ({x? : OrdValue, power? : Nat} -> OrdValue) !^"datra.ordinal.exp"

  lt := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> Bool) !^"datra.ordinal.lt"
  lte := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> Bool) !^"datra.ordinal.lte"
  gt := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> Bool) !^"datra.ordinal.gt"
  gte := "$_Expr $_Expr" as? ({x? : OrdValue, y? : OrdValue} -> Bool) !^"datra.ordinal.gte"

yield public this
