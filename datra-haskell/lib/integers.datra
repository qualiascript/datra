yield Ints := begin

  max := {Args Int,} -> Maybe Int do
    values := val it
    let maximum := {candidate? : Int, remaining? : List Int} -> Int do
    yield if empty remaining then candidate
      else begin
        let next := maximum (remaining[0]; remaining[range 1 upwards])
      yield if candidate of from next upwards then candidate else next
  yield if empty values then nothing
    else maximum (values[0]; values[range 1 upwards])

  min := {Args Int,} -> Maybe Int do
    values := val it
    let minimum := {candidate? : Int, remaining? : List Int} -> Int do
    yield if empty remaining then candidate
      else begin
        let next := minimum (remaining[0]; remaining[range 1 upwards])
      yield if candidate of from next downwards then candidate else next
  yield if empty values then nothing
    else minimum (values[0]; values[range 1 upwards])

yield public this
