yield Std := begin

  Any := external "datra.Any"
  Nat := external "datra.Nat"
  Int := external "datra.Int"
  Char := external "datra.Char"
  List := (for T? of Any) -> Any yield fun (() | T; this)
  Str := List Char
  StrTempl := external "datra.StrTempl"
  IdenStr := external "datra.IdenStr"

  false := (False : 0)
  true := (True : 1)
  nothing := $Nothing
  Bool := (false | true)
  _Wards := ($upwards | $downwards)

  _AST := external "datra.AST"
  _Expr := external "datra.Expr"
  _IdenExp := external "datra.IdenExp"
  _Block := external "datra.Block"
  _Pages := external "datra.Pages"
  NatRange := external "datra.NatRange"
  IntRange := external "datra.IntRange"
  NatValRange := external "datra.NatValRange"
  IntValRange := external "datra.IntValRange"
  public := external "datra.public"

  from := (
    ("$Int to $Int" as? (Int, Int -> IntValRange) external "datra.from") |
    ("$Int $_Wards" as? (Int, _Wards -> IntValRange) external "datra.from")
  )
  range := (
    ("$Int to $Int" as? (Int, Int -> IntRange) external "datra.range") |
    ("$Int $_Wards" as? (Int, _Wards -> IntRange) external "datra.range")
  )

  # Syntax adapters receive ASTs. The sum is one value bound to one identifier.
  if := (
    ("$_Expr then $_Expr else $_Expr" as (_AST, _AST, _AST -> _AST) external "datra.syntax.if") |
    ("$_Expr then $_Expr" as (_AST, _AST -> _AST) external "datra.syntax.ifThen")
  )
  begin : "$_Block yield $_Expr" as (_AST, _AST -> _AST) := external "datra.syntax.begin"
  do := (
    ("$_Block yield $_Expr" as (_AST, _AST -> _AST) external "datra.syntax.do") |
    ("begin $_Block yield $_Expr" as (_AST, _AST -> _AST) external "datra.syntax.do")
  )
  let : "$_Expr" as (_AST -> _AST) := external "datra.syntax.let"
  fun : "$_Expr" as (_AST -> _AST) := external "datra.syntax.fun"
  with : "$_IdenExp of $_Expr" as (_AST, _AST -> _AST) := external "datra.syntax.with"
  for : "$_IdenExp of $_Expr" as (_AST, _AST -> _AST) := external "datra.syntax.for"
  _eval : "$_Expr at $_Pages" as (_AST, _AST -> _AST) := external "datra.syntax.eval"

yield public this
