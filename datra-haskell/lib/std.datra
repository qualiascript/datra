yield Std := begin

  Any := _external "datra.Any"
  Nat := _external "datra.Nat"
  Int := _external "datra.Int"
  Char := _external "datra.Char"
  List := (for T? of Any) -> Any yield fun (() | T; this)
  Maybe := (for T? of Any) -> Any yield $Nothing | Just : T
  Str := List Char
  StrTempl := _external "datra.StrTempl"
  IdenStr := _external "datra.IdenStr"

  false := (False : 0)
  true := (True : 1)
  nothing := $Nothing
  Bool := (false | true)
  _Wards := ($upwards | $downwards)

  _AST := _external "datra.AST"
  _Expr := _external "datra.Expr"
  _IdenExp := _external "datra.IdenExp"
  _Block := _external "datra.Block"
  _Pages := _external "datra.Pages"

  NatRange := _external "datra.NatRange"
  IntRange := _external "datra.IntRange"
  NatValRange := _external "datra.NatValRange"
  IntValRange := _external "datra.IntValRange"
  public := _external "datra.public"

  from := (
    ("$Int to $Int" as? (Int, Int -> IntValRange) _external "datra.from") |
    ("$Int $_Wards" as? (Int, _Wards -> IntValRange) _external "datra.from")
  )
  range := (
    ("$Int to $Int" as? (Int, Int -> IntRange) _external "datra.range") |
    ("$Int $_Wards" as? (Int, _Wards -> IntRange) _external "datra.range")
  )

  # Syntax adapters receive ASTs. The sum is one value bound to one identifier.
  if := (
    ("$_Expr then $_Expr else $_Expr" as (_AST, _AST, _AST -> _AST) _external "datra.syntax.if") |
    ("$_Expr then $_Expr" as (_AST, _AST -> _AST) _external "datra.syntax.ifThen")
  )
  begin : "$_Block yield $_Expr" as (_AST, _AST -> _AST) := _external "datra.syntax.begin"
  do := (
    ("$_Block yield $_Expr" as (_AST, _AST -> _AST) _external "datra.syntax.do") |
    ("begin $_Block yield $_Expr" as (_AST, _AST -> _AST) _external "datra.syntax.do")
  )
  let : "$_Expr" as (_AST -> _AST) := _external "datra.syntax.let"
  fun : "$_Expr" as (_AST -> _AST) := _external "datra.syntax.fun"
  with := (
    ("$_IdenExp of $_Expr" as (_AST, _AST -> _AST) _external "datra.syntax.with") |
    ("$IdenStr in $_Expr do $_Expr" as (_AST, _AST, _AST -> _AST) _external "datra.syntax.withIn")
  )
  Args := (for T? of Any) -> Any do
    slots := with i in Nat do "arg%(i)"? : T
  yield () | with n in Nat do slots[range 0 to n]
  for := (
    ("$_IdenExp of $_Expr" as (_AST, _AST -> _AST) _external "datra.syntax.for") |
    ("$IdenStr in $_Expr do $_Expr" as (_AST, _AST, _AST -> _AST) _external "datra.syntax.forIn")
  )

  _eval : "$_Expr at $_Pages" as (_AST, _AST -> _AST) := _external "datra.syntax.eval"

yield public this
