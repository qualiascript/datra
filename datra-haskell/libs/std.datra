begin : "$_Block yield $_Expr" as (_AST, _AST -> _AST) := yield !$~"datra.syntax.begin"

yield Std := begin

  Any := !$~"datra.Any"
  Ordinal := !$~"datra.Ordinal"
  Char := !$~"datra.Char"
  StrTempl := !$~"datra.StrTempl"
  IdenStr := !$~"datra.IdenStr"

  Infinity := $PosInf
  SignedInfinity := Infinity | $NegInf
  false := (False : 0)
  true := (True : 1)
  nothing := $Nothing
  Bool := false | true
  _Direction := $up | $down

  _AST := !$~"datra.AST"
  _Expr := !$~"datra.Expr"
  _IdenExp := !$~"datra.IdenExp"
  _Block := !$~"datra.Block"

  # Syntax adapters precede every declaration that uses them. Parsing the
  # library therefore follows the same left-to-right binding rule as any file.
  if :=
    ("$_Expr then $_Expr else $_Expr" as (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.if") |
    ("$_Expr then $_Expr" as (_AST, _AST -> _AST) yield !$~"datra.syntax.ifThen")
  super := !$~"datra.syntax.super"
  begin := super.begin
  do :=
    ("$_Block yield $_Expr" as (_AST, _AST -> _AST) yield !$~"datra.syntax.do") |
    ("begin $_Block yield $_Expr" as (_AST, _AST -> _AST) yield !$~"datra.syntax.do")
  let : "$_Expr" as _AST -> _AST := yield !$~"datra.syntax.let"
  fun : "$_Expr" as _AST -> _AST := yield !$~"datra.syntax.fun"
  with :=
    ("$_IdenExp of $_Expr" as (_AST, _AST -> _AST) yield !$~"datra.syntax.with") |
    ("$_IdenExp in $_Expr do $_Expr" as (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.withIn") |
    ("$_IdenExp $IntValRange do $_Expr" as (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.withIn")
  for :=
    ("$_IdenExp of $_Expr" as (_AST, _AST -> _AST) yield !$~"datra.syntax.for") |
    ("$_IdenExp in $_Expr do $_Expr" as (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.forIn") |
    ("$_IdenExp $IntValRange do $_Expr" as (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.forIn")
  val := "$_Expr" as _AST -> _AST yield !$~"datra.syntax.val"
  public := !$~"datra.public"

  List := for T? of Any do yield fun (() | T; this)
  InhabitedList := for T? of Any do yield (T; List T)
  Just := for T? of Any do yield Just : T
  Maybe := for T? of Any do yield (Nothing? : ()) | Just T
  Str := List Char

  NatRange := !$~"datra.NatRange"
  IntRange := !$~"datra.IntRange"
  NatValRange := !$~"datra.NatValRange"
  IntValRange := !$~"datra.IntValRange"

  let from :=
    ("$Int to $IntLimit" as? {origin : Int; target : IntLimit} -> IntValRange yield !$~"datra.from") |
    ("$Int $_Direction" as? {origin : Int; direction : _Direction} -> IntValRange yield !$~"datra.from")
  let range :=
    ("$IntLimit to $IntLimit" as? {origin : IntLimit; target : IntLimit} -> IntRange yield !$~"datra.range") |
    ("$IntLimit $_Direction" as? {origin : IntLimit; direction : _Direction} -> IntRange yield !$~"datra.range")

  let Nat := from 0 up
  let NatLimit := from 0 to Infinity
  let Int := >< (Nat; $Complement?)
  let IntLimit := >< (NatLimit; $Complement?)

  Args := for T? of Any do
    slots := with i in Nat do "arg%(i)"? : T
  yield () | with n in Nat do slots[range 0 to n]

yield public this
