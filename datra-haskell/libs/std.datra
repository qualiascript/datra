begin : %"begin $_Block yield $_Expr" %> (_AST, _AST -> _AST) := yield !$~"datra.syntax.begin"

yield Std := begin

  Any := !$~"datra.Any"
  Ordinal := !$~"datra.Ordinal"
  Char := !$~"datra.Char"
  Template := !$~"datra.Template"
  _SyntaxTemplate := !$~"datra.SyntaxTemplate"
  IdenStr := !$~"datra.IdenStr"

  Infinity := $PosInf
  SignedInfinity := Infinity | $NegInf
  false := (False : 0)
  true := (True : 1)
  nothing := $Nothing
  Bool := false | true
  _Direction := $up | $down

  NatRange := !$~"datra.NatRange"
  IntRange := !$~"datra.IntRange"
  NatValRange := !$~"datra.NatValRange"
  IntValRange := !$~"datra.IntValRange"

  _AST := !$~"datra.AST"
  _Expr := !$~"datra.Expr"
  _IdenExp := !$~"datra.IdenExp"
  _Block := !$~"datra.Block"

  # Syntax adapters precede every declaration that uses them. Parsing the
  # library therefore follows the same left-to-right binding rule as any file.
  if :=
    (%"if $_Expr then $_Expr else $_Expr" %> (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.if") |
    (%"if $_Expr then $_Expr" %> (_AST, _AST -> _AST) yield !$~"datra.syntax.ifThen")
  super := !$~"datra.syntax.super"
  begin := super.begin
  do :=
    %(
      "do begin $_Block yield $_Expr"
      "do $_Block yield $_Expr"
    ) %> (_AST, _AST -> _AST) yield !$~"datra.syntax.do"
  let : %"let $_Expr" %> _AST -> _AST := yield !$~"datra.syntax.let"
  fun : %"fun $_Expr" %> _AST -> _AST := yield !$~"datra.syntax.fun"
  with :=
    (%"with $_IdenExp of $_Expr" %> (_AST, _AST -> _AST) yield !$~"datra.syntax.with") |
    (%(
      "with $_IdenExp in $_Expr do $_Expr"
      "with $_IdenExp $IntValRange do $_Expr"
    ) %> (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.withIn")
  for :=
    (%"for $_IdenExp of $_Expr" %> (_AST, _AST -> _AST) yield !$~"datra.syntax.for") |
    (%(
      "for $_IdenExp in $_Expr do $_Expr"
      "for $_IdenExp $IntValRange do $_Expr"
    ) %> (_AST, _AST, _AST -> _AST) yield !$~"datra.syntax.forIn")
  val := %"val $_Expr" %> _AST -> _AST yield !$~"datra.syntax.val"
  public := !$~"datra.public"

  List := for T? of Any do yield fun (() | T; this)
  let InhabitedList := for T? of Any do yield (T; List T)
  Just := for T? of Any do yield Just : T
  Maybe := for T? of Any do yield (Nothing? : ()) | Just T
  Str := List Char

  let from :=
    (%"from $Int to $IntLimit" %> {origin : Int; target : IntLimit} -> IntValRange yield !$~"datra.from") |
    (%"from $Int $_Direction" %> {origin : Int; direction : _Direction} -> IntValRange yield !$~"datra.from")
  let range :=
    (%"range $IntLimit to $IntLimit" %> {origin : IntLimit; target : IntLimit} -> IntRange yield !$~"datra.range") |
    (%"range $IntLimit $_Direction" %> {origin : IntLimit; direction : _Direction} -> IntRange yield !$~"datra.range")

  let Nat := from 0 up
  let NatLimit := from 0 to Infinity
  let Int := >< (Nat; $Complement?)
  let IntLimit := >< (NatLimit; $Complement?)

  Args := for T? of Any do
    slots := with i in Nat do "arg%(i)"? : T
  yield () | with n in Nat do slots[range 0 to n]

yield public this
