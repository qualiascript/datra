(datra.begin (()
  Std := datra.begin ((
    _Expr := datra.Expr
    _DependentArgument := datra.DependentArgument
    _DependentDeclaration := datra.DependentDeclaration
    _Block := datra.Block
    _FunctionBody := datra.FunctionBody

    %($let; _DependentDeclaration) :=
      (_DependentDeclaration -> _DependentDeclaration) datra.let_body
    let def := (_DependentDeclaration -> _DependentDeclaration) datra.def_body
    let val := (_DependentDeclaration -> _DependentDeclaration) datra.val_body

    def val datra := datra

    val Any := datra.Any
    val Never := datra.never
    val Ordinal := datra.Ordinal
    val Char := datra.Char
    val Template := datra.Template
    val IdenStr := datra.IdenStr

    val Infinity := $PosInf
    val SignedInfinity := Infinity | $NegInf
    val false := (False : 0)
    val true := (True : 1)
    val nothing := (Nothing? : ())
    val Bool := false | true
    _Direction := $up | $down

    val NatRange := datra.NatRange
    val IntRange := datra.IntRange
    val NatValRange := datra.NatValRange
    val IntValRange := datra.IntValRange

    %($begin; _Block; $yield; _Expr) := datra.begin
    %($fun; _Expr) := (_Expr -> _Expr) datra.fun_body
    %($if; _Expr; $then; _Expr; ($else; _Expr)?) :=
      (_Expr; _Expr; _Expr? -> _Expr) datra.if_body
    %($import; (List Str); _FunctionBody) :=
      (List Str; _FunctionBody -> _Expr) datra.import_body
    %($len; _Expr) := (Any -> NatLimit) datra.len_body
    %($with; (List _Expr); _FunctionBody) :=
      (List _Expr; _FunctionBody -> _Expr) datra.with_body

    # These parsing rules are ordered from lower to higher precedence.
    %(_Expr; $or; _Expr) := (_Expr; _Expr -> _Expr) datra.or_body
    %(_Expr; $and; _Expr) := (_Expr; _Expr -> _Expr) datra.and_body
    %(_Expr; $of; _Expr) := (_Expr; _Expr -> _Expr) datra.of_body
    %($not; _Expr) := (_Expr -> _Expr) datra.not_body

    %($do; _Block; $yield; _Expr) :=
      (_Block; _Expr -> _FunctionBody) datra.do_body
    let val %($from; Int; ($to; IntLimit) | _Direction) :=
      ({origin : Int; ((target? : IntLimit) | (direction? : _Direction))} -> IntValRange) datra.from_body
    let val %($range; IntLimit; $to; IntLimit) :=
      ({origin : IntLimit; target? : IntLimit} -> IntRange) datra.range_body

    let val List := &T? do yield fun () | (T; this)
    val InhabitedList := &T? do yield (T; List T)
    let val Just := &T? do yield Just : T
    let val Maybe := &T? do yield nothing | Just T
    let val Str := >< (List Char)
    let val InhabitedStr := >< (InhabitedList Char)
    val Stream := &T? do yield fun (T ; this)
    val Collection := &T? do yield (List T) | (Stream T)

    let val Nat := from 0 up
    let val NatLimit := from 0 to Infinity
    let val Int := >< (Nat; $Complement?)
    let val IntLimit := >< (NatLimit; $Complement?)

    val Args := &T? do
      slots := (^_i :: Nat) do yield "arg%(_i)"? : T
    yield ((^n? :: Nat) do yield slots[0..n])

    val _DeclarationEntry := {_key : InhabitedStr; _value : Any; $val?; $def?}

    public := {_declarations : Collection _DeclarationEntry} do
      yield (
        ((&_declaration :: _declarations) do
          yield if _declaration._key[0] = "_" then () else _declaration),
      )

  )
  public this))
)
