begin := %"begin $_Block yield $_Expr" %> (_AST, _AST -> _AST) !$~"datra.syntax.begin"

Std := begin

  Any := !$~"datra.Any"
  Ordinal := !$~"datra.Ordinal"
  Char := !$~"datra.Char"
  Template := !$~"datra.Template"
  _SyntaxTemplate := !$~"datra.SyntaxTemplate"
  IdenStr := !$~"datra.IdenStr"

  Infinity := $PosInf
  SignedInfinity := Infinity | $NegInf
  false := (False : 0)
  true := (True : 1)
  nothing := $Nothing
  Bool := false | true
  _Direction := $up | $down

  NatRange := !$~"datra.NatRange"
  IntRange := !$~"datra.IntRange"
  NatValRange := !$~"datra.NatValRange"
  IntValRange := !$~"datra.IntValRange"

  _AST := !$~"datra.AST"
  _Expr := !$~"datra.Expr"
  _IdenExp := !$~"datra.IdenExp"
  _Block := !$~"datra.Block"

  assert :=
    (%"assert %("hard") $_Expr" %>
      ({_AST, $hard} -> _AST) !$~"datra.syntax.assertHard") |
    (%"assert $_Expr" %> (_AST -> _AST) !$~"datra.syntax.assert")
  or := %"$_Expr or $_Expr" %> (_AST, _AST -> _AST) !$~"datra.syntax.or"
  and := %"$_Expr and $_Expr" %> (_AST, _AST -> _AST) !$~"datra.syntax.and"
  of := %"$_Expr of $_Expr" %> (_AST, _AST -> _AST) !$~"datra.syntax.of"
  not := %"not $_Expr" %> (_AST -> _AST) !$~"datra.syntax.not"
  if :=
    (%"if $_Expr then $_Expr else $_Expr" %>
      (_AST, _AST, _AST -> _AST) !$~"datra.syntax.if") |
    (%"if $_Expr then $_Expr" %>
      (_AST, _AST -> _AST) !$~"datra.syntax.ifThen")
  super := !$~"datra.syntax.super"
  begin := super.begin
  do := %"do $_Block yield $_Expr" %> (_AST, _AST -> _AST) !$~"datra.syntax.do"
  let := %"let $_Expr" %> (_AST -> _AST) !$~"datra.syntax.let"
  fun := %"fun $_Expr" %> (_AST -> _AST) !$~"datra.syntax.fun"
  with :=
    (%"with $_IdenExp of $_Expr" %>
      (_AST, _AST -> _AST) !$~"datra.syntax.with") |
    (%(
        "with $_IdenExp in $_Expr do $_Expr"
        "with $_IdenExp $IntValRange do $_Expr"
      ) %>
      (_AST, _AST, _AST -> _AST) !$~"datra.syntax.withIn")
  for :=
    (%"for $_IdenExp of $_Expr" %>
      (_AST, _AST -> _AST) !$~"datra.syntax.for") |
    (%(
        "for $_IdenExp in $_Expr do $_Expr"
        "for $_IdenExp $IntValRange do $_Expr"
      ) %>
      (_AST, _AST, _AST -> _AST) !$~"datra.syntax.forIn")
  val := %"val $_Expr" %> (_AST -> _AST) !$~"datra.syntax.val"
  public := !$~"datra.public"

  List := for T? of Any do yield fun (() | T; this)
  let InhabitedList := for T? of Any do yield (T; List T)
  Just := for T? of Any do yield Just : T
  Maybe := for T? of Any do yield (Nothing? : ()) | Just T
  Str := List Char

  import :=
    (%"import %("all") $Str" %>
      ({$all, Str} -> ()) !$~"datra.importAll") |
    (%"import $Str" %> (Str -> ()) !$~"datra.import")

  let from :=
    (%"from $Int to $IntLimit" %>
      ({origin : Int; target : IntLimit} -> IntValRange) !$~"datra.from") |
    (%"from $Int $_Direction" %>
      ({origin : Int; direction : _Direction} -> IntValRange) !$~"datra.from")
  let range :=
    (%"range $IntLimit to $IntLimit" %>
      ({origin : IntLimit; target : IntLimit} -> IntRange) !$~"datra.range") |
    (%"range $IntLimit $_Direction" %>
      ({origin : IntLimit; direction : _Direction} -> IntRange) !$~"datra.range")

  let Nat := from 0 up
  let NatLimit := from 0 to Infinity
  let Int := >< (Nat; $Complement?)
  let IntLimit := >< (NatLimit; $Complement?)

  Args := for T? of Any do
    slots := with i in Nat do "arg%(i)"? : T
  yield () | with n in Nat do slots[range 0 to n]

yield public this
