Std := !~"datra.begin" ((
  _Expr := !~"datra.Expr"
  _IdenExp := !~"datra.IdenExp"
  _Block := !~"datra.Block"
  _FunctionBody := !~"datra.FunctionBody"

  Any := !~"datra.Any"
  Never := !~"datra.never"
  Ordinal := !~"datra.Ordinal"
  Char := !~"datra.Char"
  Template := !~"datra.Template"
  IdenStr := !~"datra.IdenStr"

  Infinity := $PosInf
  SignedInfinity := Infinity | $NegInf
  false := (False : 0)
  true := (True : 1)
  nothing := (Nothing? : ())
  Bool := false | true
  _Direction := $up | $down

  NatRange := !~"datra.NatRange"
  IntRange := !~"datra.IntRange"
  NatValRange := !~"datra.NatValRange"
  IntValRange := !~"datra.IntValRange"

  # These bindings introduce parsing rules.
  'let := "let %_Expr" % (_Expr -> _Expr) !~"datra.let"
  'assert :=
    ("assert %("hard") %_Expr" %
      ($hard; _Expr -> _Expr) !~"datra.assertHard") |
    ("assert %_Expr" % (_Expr -> _Expr) !~"datra.assert")
  'begin :=
    "begin %_Block yield %_Expr" %
      (_Block; _Expr -> _Expr) !~"datra.begin"
  'do :=
    "do %_Block yield %_Expr" %
      (_Block; _Expr -> _FunctionBody) !~"datra.do"
  let 'from :=
    ("from %Int to %IntLimit" %
      ({origin : Int; target : IntLimit} -> IntValRange) !~"datra.from") |
    ("from %Int %_Direction" %
      ({origin : Int; direction : _Direction} -> IntValRange) !~"datra.from")
  'fun := "fun %_Expr" % (_Expr -> _Expr) !~"datra.fun"
  'if :=
    ("if %_Expr then %_Expr else %_Expr" %
      (_Expr; _Expr; _Expr -> _Expr) !~"datra.if") |
    ("if %_Expr then %_Expr" %
      (_Expr; _Expr -> _Expr) !~"datra.ifThen")
  'import :=
    "import %(List Str) %_FunctionBody" %
      (List Str; _FunctionBody -> _Expr) !~"datra.import"
  'with :=
    "with %(List _Expr) %_FunctionBody" %
      (List _Expr; _FunctionBody -> _Expr) !~"datra.with"
  'in := "%_Expr in %_Expr" % (_Expr; _Expr -> _Expr) !~"datra.in"
  'len := "len %_Expr" % (Any -> NatLimit) !~"datra.len"
  'modular := "modular %_Expr" % (_Expr -> _Expr) !~"datra.modular"
  let 'range :=
    ("range %IntLimit to %IntLimit" %
      ({origin : IntLimit; target : IntLimit} -> IntRange) !~"datra.range") |
    ("range %IntLimit %_Direction" %
      ({origin : IntLimit; direction : _Direction} -> IntRange) !~"datra.range")

  # These parsing rules are ordered from lower to higher precedence.
  or := "%_Expr or %_Expr" % (_Expr; _Expr -> _Expr) !~"datra.or"
  and := "%_Expr and %_Expr" % (_Expr; _Expr -> _Expr) !~"datra.and"
  of := "%_Expr of %_Expr" % (_Expr; _Expr -> _Expr) !~"datra.of"
  not := "not %_Expr" % (_Expr -> _Expr) !~"datra.not"

  let List := &T? do yield fun () | (T; this)
  InhabitedList := &T? do yield (T; List T)
  Just := &T? do yield Just : T
  Maybe := &T? do yield nothing | Just T
  let Str := >< (List Char)

  let Nat := from 0 up
  let NatLimit := from 0 to Infinity
  let Int := >< (Nat; $Complement?)
  let IntLimit := >< (NatLimit; $Complement?)

  Args := &T? do
    slots := (^_i :: Nat) do yield "arg%(_i)"? : T
  yield ((^n? :: Nat) do yield slots[0..n])

  public := !~"datra.public"
)
public modular this)
