('datra.begin (()
  Std := 'datra.begin ((
    _Expr := 'datra.Expr
    _DependentIdentifier := 'datra.DependentIdentifier
    _DependentDeclaration := 'datra.DependentDeclaration
    _Block := 'datra.Block
    _FunctionBody := 'datra.FunctionBody

    'datra.val in it ("val %_DependentDeclaration" :=
      (_DependentDeclaration -> _DependentDeclaration) it)
    val 'datra := 'datra

    val Any := 'datra.Any
    val Never := 'datra.never
    val Ordinal := 'datra.Ordinal
    val Char := 'datra.Char
    val Template := 'datra.Template
    val IdenStr := 'datra.IdenStr

    val Infinity := $PosInf
    val SignedInfinity := Infinity | $NegInf
    val false := (False : 0)
    val true := (True : 1)
    val nothing := (Nothing? : ())
    val Bool := false | true
    _Direction := $up | $down

    val NatRange := 'datra.NatRange
    val IntRange := 'datra.IntRange
    val NatValRange := 'datra.NatValRange
    val IntValRange := 'datra.IntValRange

    val "let %_DependentDeclaration" :=
      (_DependentDeclaration -> _DependentDeclaration) 'datra.let
    let "%_Expr in %_Expr" := (_Expr; _Expr -> _Expr) 'datra.in

    "assert %("hard") %_Expr" := ($hard; _Expr -> _Expr) 'datra.assertHard
    "assert %_Expr" := (_Expr -> _Expr) 'datra.assert
    val "begin %_Block yield %_Expr" :=
      (_Block; _Expr -> _Expr) 'datra.begin
    val "do %_Block yield %_Expr" :=
      (_Block; _Expr -> _FunctionBody) 'datra.do
    let val "from %Int to %IntLimit" :=
      ({origin : Int; target : IntLimit} -> IntValRange) 'datra.from
    let val "from %Int %_Direction" :=
      ({origin : Int; direction : _Direction} -> IntValRange) 'datra.from
    val "fun %_Expr" := (_Expr -> _Expr) 'datra.fun
    val "if %_Expr then %_Expr else %_Expr" :=
      (_Expr; _Expr; _Expr -> _Expr) 'datra.if
    val "if %_Expr then %_Expr" :=
      (_Expr; _Expr -> _Expr) 'datra.ifThen
    val "import %(List Str) %_FunctionBody" :=
      (List Str; _FunctionBody -> _Expr) 'datra.import
    val "with %(List _Expr) %_FunctionBody" :=
      (List _Expr; _FunctionBody -> _Expr) 'datra.with
    val "len %_Expr" := (Any -> NatLimit) 'datra.len
    let val "range %IntLimit to %IntLimit" :=
      ({origin : IntLimit; target : IntLimit} -> IntRange) 'datra.range
    let val "range %IntLimit %_Direction" :=
      ({origin : IntLimit; direction : _Direction} -> IntRange) 'datra.range

    # These parsing rules are ordered from lower to higher precedence.
    val "%_Expr or %_Expr" := (_Expr; _Expr -> _Expr) 'datra.or
    val "%_Expr and %_Expr" := (_Expr; _Expr -> _Expr) 'datra.and
    val "%_Expr of %_Expr" := (_Expr; _Expr -> _Expr) 'datra.of
    val "not %_Expr" := (_Expr -> _Expr) 'datra.not

    let val List := &T? do yield fun () | (T; this)
    val InhabitedList := &T? do yield (T; List T)
    val Just := &T? do yield Just : T
    val Maybe := &T? do yield nothing | Just T
    let val Str := >< (List Char)
    let val InhabitedStr := >< (InhabitedList Char)

    let val Nat := from 0 up
    let val NatLimit := from 0 to Infinity
    let val Int := >< (Nat; $Complement?)
    let val IntLimit := >< (NatLimit; $Complement?)

    val Args := &T? do
      slots := (^_i :: Nat) do yield "arg%(_i)"? : T
    yield ((^n? :: Nat) do yield slots[0..n])

    val public := {_declarations : List (_name : InhabitedStr; Any; $val?)} do
      yield (
        ((&_declaration :: _declarations) do
          yield if _declaration._name[0] = "_" then () else _declaration),
      )

  )
  public this))
)
