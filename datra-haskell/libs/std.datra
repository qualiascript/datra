_AST := !~"datra.AST"
_Expr := !~"datra.Expr"
_IdenExp := !~"datra.IdenExp"
_Block := !~"datra.Block"

'begin := "begin %_Block yield %_Expr" % (_AST, _AST -> _AST) !~"datra.begin"

yield Std := begin

  Any := !~"datra.Any"
  Never := !~"datra.never"
  Ordinal := !~"datra.Ordinal"
  Char := !~"datra.Char"
  Template := !~"datra.Template"
  IdenStr := !~"datra.IdenStr"

  Infinity := $PosInf
  SignedInfinity := Infinity | $NegInf
  false := (False : 0)
  true := (True : 1)
  nothing := (Nothing? : ())
  Bool := false | true
  _Direction := $up | $down

  NatRange := !~"datra.NatRange"
  IntRange := !~"datra.IntRange"
  NatValRange := !~"datra.NatValRange"
  IntValRange := !~"datra.IntValRange"

  # These bindings introduce parsing rules.
  'let := "let %_Expr" % (_AST -> _AST) !~"datra.let"
  'assert :=
    ("assert %("hard") %_Expr" %
      (($hard; _AST) -> _AST) !~"datra.assertHard") |
    ("assert %_Expr" % (_AST -> _AST) !~"datra.assert")
  'begin := 'begin
  'do := "do %_Block yield %_Expr" % (_AST, _AST -> _AST) !~"datra.do"
  let 'from :=
    ("from %Int to %IntLimit" %
      ({origin : Int; target : IntLimit} -> IntValRange) !~"datra.from") |
    ("from %Int %_Direction" %
      ({origin : Int; direction : _Direction} -> IntValRange) !~"datra.from")
  'fun := "fun %_Expr" % (_AST -> _AST) !~"datra.fun"
  'if :=
    ("if %_Expr then %_Expr else %_Expr" %
      (_AST, _AST, _AST -> _AST) !~"datra.if") |
    ("if %_Expr then %_Expr" %
      (_AST, _AST -> _AST) !~"datra.ifThen")
  'import :=
    ("import %("all") %Str" %
      (($all; Str) -> ()) !~"datra.importAll") |
    ("import %Str" % (Str -> ()) !~"datra.import")
  'len := "len %_Expr" % (Any -> NatLimit) !~"datra.len"
  'modular := "modular %_Expr" % (_AST -> _AST) !~"datra.modular"
  let 'range :=
    ("range %IntLimit to %IntLimit" %
      ({origin : IntLimit; target : IntLimit} -> IntRange) !~"datra.range") |
    ("range %IntLimit %_Direction" %
      ({origin : IntLimit; direction : _Direction} -> IntRange) !~"datra.range")

  # These parsing rules are ordered from lower to higher precedence.
  or := "%_Expr or %_Expr" % (_AST, _AST -> _AST) !~"datra.or"
  and := "%_Expr and %_Expr" % (_AST, _AST -> _AST) !~"datra.and"
  of := "%_Expr of %_Expr" % (_AST, _AST -> _AST) !~"datra.of"
  not := "not %_Expr" % (_AST -> _AST) !~"datra.not"

  List := &T? -> Any do yield fun () | (T; this)
  InhabitedList := &T? -> Any do yield (T; List T)
  Just := &T? -> Any do yield Just : T
  Maybe := &T? -> Any do yield nothing | Just T
  let Str := >< (List Char)
  public := !~"datra.public"

  let Nat := from 0 up
  let NatLimit := from 0 to Infinity
  let Int := >< (Nat; $Complement?)
  let IntLimit := >< (NatLimit; $Complement?)

  Args := &T? -> Any do
    slots := (^_i :: Nat) -> Any do yield "arg%(_i)"? : T
  yield ((^n? :: Nat) -> Any do yield slots[0..n])

yield public modular this
