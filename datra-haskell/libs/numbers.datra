yield Numbers := begin

  max := {Args IntLimit,} -> IntLimit? do
  yield val it !? fun {candidate? : IntLimit, remaining? : List IntLimit} -> IntLimit do
    yield if candidate = Infinity or remaining = () then candidate
      else begin
        let next := this remaining[0; range 1 up]
      yield if candidate >= next then candidate else next

  min := {Args IntLimit,} -> IntLimit? do
  yield val it !? fun {candidate? : IntLimit, remaining? : List IntLimit} -> IntLimit do
    yield if candidate = -Infinity or remaining = () then candidate
      else begin
        let next := this remaining[0; range 1 up]
      yield if candidate <= next then candidate else next

yield public this
