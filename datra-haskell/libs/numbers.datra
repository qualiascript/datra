import all "std"

yield Numbers := begin

  max := {Args IntLimit,} -> IntLimit? do
    yield it !? fun {candidate? : IntLimit; remaining? : List IntLimit} -> IntLimit do
      yield if candidate = Infinity or remaining = () or
        candidate >= (next : this remaining[0; 1..]) then
          candidate else next

  min := {Args IntLimit,} -> IntLimit? do
    yield it !? fun {candidate? : IntLimit; remaining? : List IntLimit} -> IntLimit do
      yield if candidate = -Infinity or remaining = () or
        candidate <= (next : this remaining[0; 1..]) then
          candidate else next

yield public this
