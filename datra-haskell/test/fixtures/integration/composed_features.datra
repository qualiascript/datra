(import "ordinals" do
  let factorial := ({n? : Int := 5} -> Int do
    yield if n = 0 then 1 else n * factorial (n - 1))
  my_pow := ({base? : Nat := 2; exponent? : Nat} -> Nat do yield base ^ exponent)
  sum := ((Int; Int) -> Int do yield it[0] + it[1])
  parsed := ("from 2 to 5" ~> "from %Int to %Int")
  overloaded := ({x? : Nat := 2; Nat} << 4)
  safe := ((x? : Nat := 2; Nat) <<< (*; 7))
  transfinite := Ordinals.sum(Ordinals.exp(...; 2); Ordinals.sum(Ordinals.prod(...; 3); 4))
  sequence := (10; 20; 30; 40)
  slice := sequence[1..3]
  defaultCheck := factorial () = 120
  factorialCheck := factorial 6 = 720
  powerCheck := my_pow (*; 5) = 32
  sumCheck := sum (parsed[1]; parsed[2]) = 7
  overloadCheck := overloaded of {x? : Nat; Nat}
  safeCheck := safe = ((x? : Nat := 2; Nat) << (*; 7))
  transfiniteCheck := transfinite = Ordinals.sum(Ordinals.exp(...; 2); Ordinals.sum(Ordinals.prod(...; 3); 4))
  sliceCheck := slice = (20; 30)
yield (defaultCheck; factorialCheck; powerCheck; sumCheck;
  overloadCheck; safeCheck; transfiniteCheck; sliceCheck))
